rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Compte admin (uid Firebase Auth) : mêmes droits que le propriétaire sur chaque espace, pour vérifier
    // la production avec ses propres identifiants (l'appli ouvre l'espace du barman, cf. VITE_UID_DONNEES).
    function admin() { return request.auth != null && request.auth.uid == 'NpmS7OylCWPMCts197NdJ9Xil962'; }
    match /users/{uid} {
      // Le propriétaire de l'espace, ou l'admin.
      function proprietaire() { return request.auth != null && (request.auth.uid == uid || admin()); }
      // Document de l'utilisateur : seulement le marqueur d'initialisation des types de départ.
      allow read: if proprietaire();
      allow write: if proprietaire() && request.resource.data.keys().hasOnly(['typesInitialises']);
      match /cocktails/{id} { allow read, write: if proprietaire(); }
      match /types/{id} { allow read, write: if proprietaire(); }
      match /bases/{id} { allow read, write: if proprietaire(); }
      match /prestas/{prestaId} {
        allow read, write: if proprietaire();
        match /verres/{verreId} {
          allow read, delete: if proprietaire();
          allow create, update: if proprietaire()
            && request.resource.data.keys().hasOnly(['ligneId', 'creeLe', 'horodatage', 'appareil']);
        }
      }
    }
  }
}
