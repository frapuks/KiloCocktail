# Copier vers .env.local et renseigner la configuration Firebase.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# uid du compte du barman (console Firebase, onglet Authentication) : l'appli ouvre toujours son espace,
# y compris connectée avec le compte admin. Vide : chaque compte a son propre espace.
VITE_UID_DONNEES=
